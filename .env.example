# ==============================================================================
# SECUREVAULT ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env for local development.
# Configure corresponding platform environment variables on Vercel and Render.
# DO NOT commit real passwords, keys, or tokens to version control.
# ==============================================================================

# ==============================================================================
# 1. LOCAL DEVELOPMENT VARIABLES (Used by docker-compose.yml / local dev)
# ==============================================================================
POSTGRES_DB=securevault_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_postgres_password

DATABASE_URL=jdbc:postgresql://postgres:5432/securevault_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_local_postgres_password

PORT=8080
JWT_SECRET=your_dev_jwt_secret_64_character_hex_string_here
AES_SECRET_KEY=your_dev_aes_secret_key_32_chars!

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

VERIFICATION_BASE_URL=http://localhost:5173/verify-email
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,https://*.vercel.app
FAILED_LOGIN_THRESHOLD=3
FAILED_LOGIN_TIME_WINDOW_MINUTES=15
PASSWORD_EXPIRATION_DAYS=30

VITE_API_URL=http://localhost:8080/api/v1
VITE_API_BASE_URL=/api/v1


# ==============================================================================
# 2. VERCEL FRONTEND VARIABLES (Configured in Vercel Dashboard -> Settings -> Environment Variables)
# ==============================================================================
# Base URL pointing to your deployed Render Spring Boot backend
VITE_API_URL=https://YOUR-SPRINGBOOT-BACKEND.onrender.com/api/v1


# ==============================================================================
# 3. RENDER BACKEND & POSTGRESQL VARIABLES (Configured in Render Dashboard / Blueprint)
# ==============================================================================
# Database connection settings (Provided automatically by Render PostgreSQL or set manually)
DATABASE_URL=jdbc:postgresql://dpg-YOUR-RENDER-DB-HOST:5432/securevault_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_render_postgres_password

# Port configuration (Render assigns PORT automatically, Spring Boot uses ${PORT:8080})
PORT=8080

# Security Cryptographic Secrets
JWT_SECRET=your_production_jwt_secret_64_character_hex_string
AES_SECRET_KEY=your_production_aes_secret_key_32_chars!

# Existing JavaMailSender SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Application Settings & Security Policies
VERIFICATION_BASE_URL=https://YOUR-FRONTEND.vercel.app/verify-email
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app
FAILED_LOGIN_THRESHOLD=3
FAILED_LOGIN_TIME_WINDOW_MINUTES=15
PASSWORD_EXPIRATION_DAYS=30
